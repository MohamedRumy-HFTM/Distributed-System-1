# Vorlage fuer .env - kopieren und anpassen:
#
#   cp .env.example .env
#
# docker compose liest .env automatisch. Die Datei selbst ist per .gitignore
# ausgeschlossen, damit keine echten Passwoerter im Repository landen; nur diese
# Vorlage mit Platzhaltern wird eingecheckt.

# Welches Image gestartet wird. Lokal gebaut: blog-api:latest
BLOG_IMAGE=ghcr.io/mohamedrumy-hftm/blog-api:latest

# Datenbank
BLOG_DB_USER=quarkus
BLOG_DB_PASSWORD=quarkus
BLOG_DB_ROOT_PASSWORD=root

# Keycloak-Admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Beispieldaten beim Start anlegen (false = leere Datenbank)
BLOG_SEED_DATA=true
